<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.CounterView">

    <Frame x:Name="CardBorder"
           BorderColor="#14000000"
           CornerRadius="24"
           HasShadow="True"
           Padding="22,16,16,18">

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

            <Label x:Name="NameLabel"
                   Grid.Row="0" Grid.Column="0"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#6B665C"
                   VerticalOptions="Center" />

            <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
                <Button Text="Reset"
                        Clicked="ResetClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6B665C"
                        FontSize="13" />

                <Button Text="Usuń"
                        Clicked="DeleteClicked"
                        BackgroundColor="Transparent"
                        TextColor="#9A4B4B"
                        FontSize="13" />
            </HorizontalStackLayout>

            <Label x:Name="ValueLabel"
                   Grid.Row="1" Grid.Column="0"
                   FontSize="56"
                   FontAttributes="Bold"
                   TextColor="#1F1F1F"
                   VerticalOptions="Center" />

            <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <Button Text="-"
                        Clicked="MinusClicked"
                        FontSize="26"
                        WidthRequest="56"
                        HeightRequest="56"
                        CornerRadius="28"
                        Padding="0"
                        BackgroundColor="#99FFFFFF"
                        TextColor="#1F1F1F" />

                <Button Text="+"
                        Clicked="PlusClicked"
                        FontSize="26"
                        WidthRequest="56"
                        HeightRequest="56"
                        CornerRadius="28"
                        Padding="0"
                        BackgroundColor="#1F1F1F"
                        TextColor="White" />
            </HorizontalStackLayout>

        </Grid>
    </Frame>
</ContentView>
